# ---- API (apps/api) -------------------------------------------------------------
NODE_ENV=development            # development | test | production
APP_ENV=local                   # local | test | demo | production   (demo enables the demo-reset endpoint; NEVER use on real production)
PORT=4000
DATABASE_URL=postgres://gasman:CHANGE_ME@localhost:5432/gasman_tms
DB_POOL_MAX=20
JWT_ACCESS_SECRET=CHANGE_ME_to_a_long_random_string_min_32_chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false             # true when served over HTTPS
LOG_LEVEL=info
RATE_LIMIT_LOGIN_PER_15MIN=30
RATE_LIMIT_API_PER_MIN=600
BUSINESS_TZ=Asia/Karachi
# Demo-only GPS simulator (set false when real GPS arrives from the driver app)
SIM_ENABLED=true
SIM_TICK_SECONDS=5
SIM_SPEEDUP=3
# Pre-trip check, expense limits, fuel variance, payment terms etc. are now editable in the app (Settings); defaults live in code.
# Optional: fix the demo's 'today' so the seed is reproducible (ISO date-time)
# SEED_ANCHOR_DATE=2026-10-08T06:30:00Z

# ---- Web (apps/web) -------------------------------------------------------------
# VITE_API_URL=/api/v1
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
